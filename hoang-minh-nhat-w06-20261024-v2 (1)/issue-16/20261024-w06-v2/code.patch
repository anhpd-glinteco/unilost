diff --git a/tests/unit/post-image-ui-fixture.test.ts b/tests/unit/post-image-ui-fixture.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5e18d8cf72c0285c4baf49cda332399ffe935dfd
--- /dev/null
+++ b/tests/unit/post-image-ui-fixture.test.ts
@@ -0,0 +1,23 @@
+import { expect, it } from "vitest";
+import { spawnSync } from "node:child_process";
+import { existsSync } from "node:fs";
+import { randomUUID } from "node:crypto";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+it.each([
+  ["wrong project", { SUPABASE_TEST_PROJECT_REF: "aaaaaaaaaaaaaaaaaaaa", SUPABASE_TEST_URL: "https://aaaaaaaaaaaaaaaaaaaa.supabase.co" }, "Only the named UniLost test project"],
+  ["remote app", { B1F_APP_ORIGIN: "https://example.com" }, "local test app"],
+  ["invalid port", { B1F_FIXTURE_PORT: "NaN" }, "Number.isInteger"],
+])("fixture bridge rejects %s before creating files or contacting Auth", (_label, overrides, expected) => {
+  const output = join(tmpdir(), `unilost-rejected-fixture-${randomUUID()}`);
+  const result = spawnSync(process.execPath, ["scripts/post-image-ui-fixture.mjs"], {
+    encoding: "utf8",
+    env: { ...process.env, SUPABASE_TEST_PROJECT_REF: "lsaukzzmwbsztnlcrdpk", SUPABASE_TEST_URL: "https://lsaukzzmwbsztnlcrdpk.supabase.co",
+      SUPABASE_TEST_ANON_KEY: "dummy-public", SUPABASE_TEST_SERVICE_ROLE_KEY: "dummy-service",
+      B1F_APP_ORIGIN: "http://localhost:5194", B1F_FIXTURE_PORT: "5195", B1F_OUTPUT: output, ...overrides },
+  });
+  expect(result.status).not.toBe(0);
+  expect(result.stderr).toContain(expected);
+  expect(existsSync(output)).toBe(false);
+});
diff --git a/tests/unit/post-image-ui.test.tsx b/tests/unit/post-image-ui.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..d7b27c493bc547ea517477e67fb4526d216e7e66
--- /dev/null
+++ b/tests/unit/post-image-ui.test.tsx
@@ -0,0 +1,19 @@
+import { expect, it, vi } from "vitest";
+import { renderToStaticMarkup } from "react-dom/server";
+import { PostImage } from "@/features/posts/post-image";
+
+vi.mock("next/navigation", () => ({ useRouter: () => ({ refresh: vi.fn() }) }));
+
+it.each([false, true])("renders loading with write controls only for an authorized owner: %s", manageable => {
+  const html = renderToStaticMarkup(<PostImage postId="12345678-1234-4234-8234-123456789abc" manageable={manageable} />);
+  expect(html).toContain('aria-label="Ảnh món đồ"');
+  expect(html).toContain('aria-busy="true"');
+  expect(html).toContain("Đang tải ảnh");
+  expect(html.includes('type="file"')).toBe(manageable);
+  if (manageable) {
+    expect(html).toContain('accept="image/jpeg,image/png,image/webp"');
+    expect(html).toMatch(/type="file"[^>]*disabled/);
+  }
+  expect(html).not.toContain("supabase.co");
+  expect(html).not.toContain('src="/api/');
+});
